{
  "$schema": "https://layero.ru/schema/layero-v2.json",
  "layout": "fullstack",
  "frontend": {
    "root": "frontend",
    "framework": "vite",
    "installCommand": "npm install --no-audit --no-fund",
    "buildCommand": "npm run build",
    "outputDirectory": "dist"
  },
  "backend": {
    "root": "backend",
    "framework": "fastapi",
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT",
    "port": 8000
  },
  "apiPrefix": "/api"
}
